    <!-- Recovery key display, shared by onboarding and settings -->
    <string name="recovery_key_title">Your recovery key</string>
    <string name="recovery_key_subtitle">Write it down before you continue. This screen cannot be screenshotted.</string>
    <string name="recovery_key_why">If you forget your PIN, this is the only way back into your data. There is no reset, and no one can recover it for you.</string>
    <string name="recovery_key_where">Keep it somewhere other than this phone — on paper, or in a password manager. Anyone holding it can open this vault.</string>
    <string name="recovery_key_copy">Copy</string>
    <string name="recovery_key_saved">I have saved it somewhere safe</string>


    <string name="change_pin_title">Change PIN</string>
    <string name="change_pin_current_title">Enter your current PIN</string>
    <string name="change_pin_current_subtitle">Asked for so that someone holding your unlocked phone cannot quietly swap the PIN out.</string>
    <string name="change_pin_new_title">Choose a new PIN</string>
    <string name="change_pin_new_subtitle">Six digits, as before.</string>
    <string name="change_pin_confirm_title">Enter the new PIN again</string>
    <string name="change_pin_confirm_subtitle">A typo here would lock you out on the next unlock.</string>
    <string name="change_pin_note">Changing the PIN re-wraps the data key and nothing else. None of your stored keys are re-encrypted, so this takes the same time whether you have three entries or three hundred.</string>

    <!-- Recovery key (settings, Security) -->
    <string name="recovery_key_settings_title">Recovery key</string>
    <string name="recovery_key_present">This vault has a recovery key.</string>
    <string name="recovery_key_absent">This vault has no recovery key.</string>
    <string name="recovery_key_cannot_show">The existing key cannot be shown again. Only a wrapped copy of the data key is stored — the recovery key itself never touches storage. If you cannot find yours, generate a new one.</string>
    <string name="recovery_key_missing_warning">Without one, forgetting your PIN means losing every key stored here. A backup would not save you either: its passphrase defaults to that same PIN.</string>

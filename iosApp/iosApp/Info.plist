<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!--
		这个包支持哪两种语言（与 Android 侧 app 的 localeFilters 同一份清单：zh-rCN + en）。
		不声明的话系统只认 CFBundleDevelopmentRegion，凡是由系统代绘的那几处文案就无从
		挑语言——Face ID 授权框上的说明（NSFaceIDUsageDescription）、分享面板、文件 App 里的
		应用名都算。声明它不等于应用内能立刻换语言：那一行入口在 iOS 上按
		PlatformCapabilities.supportsInAppLanguageSwitch 整行不画，切换还要重启应用才生效。
	-->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>TokenVault</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
		与 Android 侧 app/src/main/AndroidManifest.xml 里那句 usesCleartextTraffic="true"
		是同一件事的另一半，缺了它「允许不安全的 HTTP」这个开关在 iOS 上是空的：
		应用层 remoteUrl() 的 require() 放行 http:// 之后，NSURLSession 仍会按 ATS 默认
		策略直接把连接掐掉（NSURLErrorDomain Code=-1022），于是同一个 WebDAV 地址在
		安卓能用、在 iOS 一句"失败"就没了下文。地址是用户自己填的，无法写成
		NSExceptionDomains 那种建包时就知道的域名，只能整体放开。
		代价写清楚：这一条同时让全应用可以走明文，App Store 审核可能要求说明理由；
		自签证书的 https 不在这条的覆盖范围内（那是证书校验，不是 ATS 策略）。
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock your vault with Face ID</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>